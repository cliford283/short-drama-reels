datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  coinBalance Int @default(0)
  transactions Transaction[]
  unlocks EpisodeUnlock[]
}

model Episode {
  id String @id @default(cuid())
  title String
  isFree Boolean @default(false)
  coinPrice Int @default(30)
  videoUrl String
}

model EpisodeUnlock {
  id String @id @default(cuid())
  userId String
  episodeId String
  @@unique([userId, episodeId])
}

model Transaction {
  id String @id @default(cuid())
  userId String
  coins Int
  status String @default("SUCCESS")
}