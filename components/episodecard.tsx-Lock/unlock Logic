"use client"

import { useState } from "react"

export default function EpisodeCard({ episodeId, userId, isLocked }: any) {
  const [loading, setLoading] = useState(false)

  async function handleUnlock() {
    setLoading(true)
    const res = await fetch('/api/unlock', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        userId: userId, 
        episodeId: episodeId,
        coinPrice: 10 
      })
    })
    
    const data = await res.json()
    alert(data.message)
    setLoading(false)
    window.location.reload() // refresh to show unlocked
  }

  return (
    <div>
      {isLocked ? (
        <button 
          onClick={handleUnlock} 
          disabled={loading}
          style={{ padding: '10px', background: 'orange', color: 'white', border: 'none', borderRadius: '8px' }}
        >
          {loading ? "Unlocking..." : "Unlock for 10 coins"}
        </button>
      ) : (
        <p>✅ Unlocked</p>
      )}
    </div>
  )
}