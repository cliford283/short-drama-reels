datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  coinBalance Int      @default(100)
  createdAt   DateTime @default(now())
}

model EpisodeUnlock {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  createdAt DateTime @default(now())
}